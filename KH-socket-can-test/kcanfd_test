#!/bin/bash

# Default values
DEFAULT_COUNT=2
DEFAULT_BITRATE=1000000
DEFAULT_DBITRATE=5000000
DEFAULT_TEST_COUNT=1000000
DEFAULT_DLC=8
DEFAULT_MODE="fd"  # CAN mode: "can" for CAN 2.0, "fd" for CAN FD

# Exit code for cleanup
exit_code=1

NUM_PORTS=$DEFAULT_COUNT
MODE=$DEFAULT_MODE
BITRATE=$DEFAULT_BITRATE
DBITRATE=$DEFAULT_DBITRATE
TEST_COUNT=$DEFAULT_TEST_COUNT
DLC=$DEFAULT_DLC
DRY_RUN=0
RELOAD_DRIVER=1

# Parse command line options
show_help() {
    echo "Usage: $0 [-c channel_count] [-p receiver:sender] [-m mode] [-b bitrate] [-d dbitrate] [-t test_count] [-s size] [--no-reload] [--dry-run]"
    echo "Options:"
    echo "  -c NUM    Number of CAN ports for auto pairing (default: $DEFAULT_COUNT)"
    echo "            Auto pairs the first NUM discovered CAN interfaces, sorted by name"
    echo "  -p PAIR   Specify a test pair in format 'receiver:sender' (e.g., -p can0:can2)"
    echo "            Accepts udev names such as kcan4:kcan5; may be repeated; overrides -c."
    echo "  -m MODE   CAN mode: 'can' for CAN 2.0 or 'fd' for CAN FD (default: $DEFAULT_MODE)"
    echo "  -b BITRATE   CAN bus arbitration bitrate in bit/s (default: $DEFAULT_BITRATE)"
    echo "  -d DBITRATE   CAN FD data bitrate in bit/s (default: $DEFAULT_DBITRATE)"
    echo "                Only applicable in CAN FD mode"
    echo "  -t COUNT  Test packet count per port (default: $DEFAULT_TEST_COUNT)"
    echo "  -s SIZE   Frame payload size in bytes"
    echo "            CAN 2.0: valid values 0-8 (default: $DEFAULT_DLC)"
    echo "            CAN FD: valid values 0-8,12,16,20,24,32,48,64 (default: $DEFAULT_DLC)"
    echo "  --no-reload    Keep loaded drivers; wait for udev and discover current CAN interfaces"
    echo "  -n, --dry-run  Show parsed configuration and exact commands without touching hardware"
    echo "  -h, --help     Show this help message"
    echo
    echo "Examples:"
    echo "  $0 -m can -c 4                      # CAN 2.0: Auto pair 4 ports with default bitrate"
    echo "  $0 -m fd -c 4                       # CAN FD: Auto pair 4 ports with default bitrates"
    echo "  $0 -m can -p can0:can2 -b 500000    # CAN 2.0: Custom pair with 500K bitrate"
    echo "  $0 -m fd -p can0:can2 -b 1000000 -d 5000000  # CAN FD: Custom pair with specified bitrates"
    echo "  $0 -m can -p can0:can2 -t 500000    # CAN 2.0: Custom pair with 500K packets"
    echo "  $0                                     # Use all defaults (CAN FD, 2 ports auto pair)"
    exit 0
}

# Array for custom pairs
CUSTOM_PAIRS=()

# Map long aliases without losing argument boundaries.
normalized_args=()
for arg in "$@"; do
    case "$arg" in
        --dry-run) normalized_args+=(-n) ;;
        --help) normalized_args+=(-h) ;;
        --no-reload) normalized_args+=(-R) ;;
        *) normalized_args+=("$arg") ;;
    esac
done
set -- "${normalized_args[@]}"
OPTIND=1
while getopts ":c:p:m:b:d:t:s:nRh" opt; do
    case $opt in
        c) NUM_PORTS="$OPTARG" ;;
        p) CUSTOM_PAIRS+=("$OPTARG") ;;
        m) MODE="$OPTARG" ;;
        b) BITRATE="$OPTARG" ;;
        d) DBITRATE="$OPTARG" ;;
        t) TEST_COUNT="$OPTARG" ;;
        s) DLC="$OPTARG" ;;
        n) DRY_RUN=1 ;;
        R) RELOAD_DRIVER=0 ;;
        h) show_help ;;
        :) echo "Error: Option -$OPTARG requires an argument" >&2; exit 1 ;;
        *) echo "Invalid option or missing argument" >&2; exit 1 ;;
    esac
done
shift $((OPTIND-1))
if (($#)); then
    echo "Error: Unexpected/unparsed arguments; no hardware was changed:" >&2
    LC_ALL=C printf ' %q' "$@" >&2
    printf '\nUse ASCII hyphens/spaces and remove positional arguments.\n' >&2
    exit 1
fi

# Validate CAN mode
if [[ "$MODE" != "can" && "$MODE" != "fd" ]]; then
    echo "Error: Invalid mode '$MODE'. Must be 'can' or 'fd'"
    exit 1
fi

# Validate each numeric parameter before dependencies, device discovery or reload.
for name in NUM_PORTS BITRATE DBITRATE TEST_COUNT; do
    value=${!name}
    if ! [[ "$value" =~ ^[0-9]+$ && "$value" =~ [1-9] ]]; then
        echo "Error: $name must be a positive integer (got '$value')" >&2
        exit 1
    fi
done

if ! [[ "$DLC" =~ ^[0-9]{1,2}$ ]]; then
    echo "Error: Frame size must be a positive integer"
    exit 1
fi

DLC=$((10#$DLC))

# Validate frame size based on CAN mode
if [[ "$MODE" == "can" ]]; then
    # CAN 2.0: only support 0-8 bytes
    if [[ "$DLC" -lt 0 || "$DLC" -gt 8 ]]; then
        echo "Error: CAN 2.0 frame size must be between 0-8 bytes"
        echo "Current size: $DLC bytes"
        exit 1
    fi
elif [[ "$MODE" == "fd" ]]; then
    # CAN FD valid data lengths: 0, 1, 2, 3, 4, 5, 6, 7, 8, 12, 16, 20, 24, 32, 48, 64
    # DLC mapping:
    #   DLC 0-8:  0-8 bytes (continuous)
    #   DLC 9:    12 bytes
    #   DLC 10:   16 bytes
    #   DLC 11:   20 bytes
    #   DLC 12:   24 bytes
    #   DLC 13:   32 bytes
    #   DLC 14:   48 bytes
    #   DLC 15:   64 bytes
    valid_canfd_lengths=(0 1 2 3 4 5 6 7 8 12 16 20 24 32 48 64)
    is_valid=false

    for valid_len in "${valid_canfd_lengths[@]}"; do
        if [[ "$DLC" -eq "$valid_len" ]]; then
            is_valid=true
            break
        fi
    done

    if [[ "$is_valid" == false ]]; then
        echo "Error: Invalid CAN FD frame size: $DLC bytes"
        echo "Valid CAN FD frame sizes are: ${valid_canfd_lengths[*]}"
        echo ""
        echo "CAN FD DLC mapping:"
        echo "  DLC 0-8:  0-8 bytes (continuous)"
        echo "  DLC 9:    12 bytes"
        echo "  DLC 10:   16 bytes"
        echo "  DLC 11:   20 bytes"
        echo "  DLC 12:   24 bytes"
        echo "  DLC 13:   32 bytes"
        echo "  DLC 14:   48 bytes"
        echo "  DLC 15:   64 bytes"
        exit 1
    fi
fi

show_configuration() {
# Display configuration
echo "Configuration:"
echo "  Mode:       $([[ "$MODE" == "can" ]] && echo "CAN 2.0" || echo "CAN FD")"
if [ ${#CUSTOM_PAIRS[@]} -gt 0 ]; then
    echo "  Pairing:    Custom pairs"
    echo "  Pairs:"
    for pair in "${CUSTOM_PAIRS[@]}"; do
        receiver="${pair%%:*}"
        sender="${pair#*:}"
        echo "    $receiver (receiver) <-> $sender (sender)"
    done
else
    echo "  Pairing:    Auto pair"
    echo "  Channels:   $NUM_PORTS"
fi
echo "  Bitrate:    $BITRATE bit/s"
if [[ "$MODE" == "fd" ]]; then
    echo "  Dbitrate:   $DBITRATE bit/s"
fi
echo "  Test count: $TEST_COUNT packets"
echo "  Frame size: $DLC bytes"
echo

}

build_groups() {
    groups=()
    if ((${#CUSTOM_PAIRS[@]})); then
        groups=("${CUSTOM_PAIRS[@]}")
    else
        for ((i=0; i+1<NUM_PORTS; i+=2)); do
            if ((DRY_RUN)); then
                groups+=("can$i:can$((i+1))")
            else
                groups+=("${CAN_DEVICES[i]}:${CAN_DEVICES[i+1]}")
            fi
        done
    fi
}

build_test_commands() {
    receiver_cmd=(kcanfdtest)
    sender_cmd=(kcanfdtest)
    if [[ "$MODE" == "fd" ]]; then
        receiver_cmd+=(-b -d)
        sender_cmd+=(-b -d)
    fi
    receiver_cmd+=(-v -s "$DLC" "$1")
    sender_cmd+=(-v -g -l "$TEST_COUNT" -s "$DLC" "$2")
}

show_test_commands() {
    printf '  Receiver command:'; printf ' %q' "${receiver_cmd[@]}"; printf '\n'
    printf '  Sender command:'; printf ' %q' "${sender_cmd[@]}"; printf '\n'
}

# Linux interface names are at most 15 bytes. Accept common udev names,
# rather than requiring canN; the actual CAN link type is checked below.
valid_interface_name() {
    local LC_ALL=C
    [[ "$1" =~ ^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,14}$ ]]
}

declare -A used_devices
for pair in "${CUSTOM_PAIRS[@]}"; do
    receiver="${pair%%:*}"
    sender="${pair#*:}"
    if [[ "$pair" != *:* ]] || ! valid_interface_name "$receiver" || ! valid_interface_name "$sender"; then
        echo "Error: Invalid pair '$pair'; expected receiver:sender (e.g. can0:can1 or kcan4:kcan5)" >&2
        exit 1
    fi
    if [[ "$receiver" == "$sender" || -n "${used_devices[$receiver]}" || -n "${used_devices[$sender]}" ]]; then
        echo "Error: Each CAN interface may appear only once in test pairs ($pair)" >&2
        exit 1
    fi
    used_devices[$receiver]=1
    used_devices[$sender]=1
done
if ((${#CUSTOM_PAIRS[@]} == 0)); then
    # Bound conversion and normalize decimal numbers such as 08 before arithmetic.
    if ((${#NUM_PORTS} > 5)) || ((10#$NUM_PORTS < 2 || 10#$NUM_PORTS % 2)); then
        echo "Error: Auto pairing requires an even number of ports, at least 2" >&2
        exit 1
    fi
    NUM_PORTS=$((10#$NUM_PORTS))
fi
if ((DRY_RUN)); then
    echo "Dry run: no commands executed; no hardware or driver changes."
    build_groups
    show_configuration
    if ((${#CUSTOM_PAIRS[@]} == 0)); then
        echo "Auto-pair preview uses can0, can1, ...; real execution discovers current CAN names."
    fi
    for group in "${groups[@]}"; do
        build_test_commands "${group%%:*}" "${group#*:}"
        show_test_commands
    done
    exit 0
fi

# Check required tools
REQUIRED_TOOLS=("ip" "ifconfig" "kcanfdtest" "bc" "awk" "sort" "sudo")
for cmd in "${REQUIRED_TOOLS[@]}"; do
    if ! command -v "$cmd" &>/dev/null; then
        echo "Error: Required command '$cmd' not found. Please install it."
        case "$cmd" in
            ip)       echo "  Install: apt install iproute2" ;;
            ifconfig) echo "  Install: apt install net-tools" ;;
            bc)       echo "  Install: apt install bc" ;;
            kcanfdtest) echo "  Build and install KH-socket-can-test first" ;;
        esac
        exit 1
    fi
done

# Discover by link-layer type, never by a substring of the interface name.
# In particular, grep 'can[0-9]+' would turn kcan4 into a nonexistent can4.
get_available_can_devices() {
    local links
    links=$(ip -o link show) || return 1
    printf '%s\n' "$links" | awk '
        /[[:space:]]link\/can([[:space:]]|$)/ {
            name=$2
            sub(/:$/, "", name)
            sub(/@.*/, "", name)
            print name
        }' | LC_ALL=C sort -Vu
}

snapshot_has_device() {
    local name
    for name in "${CAN_DEVICES[@]}"; do
        [[ "$name" == "$1" ]] && return 0
    done
    return 1
}

requested_devices_present() {
    local pair
    if ((${#CUSTOM_PAIRS[@]})); then
        for pair in "${CUSTOM_PAIRS[@]}"; do
            snapshot_has_device "${pair%%:*}" && snapshot_has_device "${pair#*:}" || return 1
        done
    else
        ((${#CAN_DEVICES[@]} >= NUM_PORTS)) || return 1
    fi
}

wait_for_can_devices() {
    local current previous='' attempt
    # udev renaming is asynchronous after modprobe. A failed settle must not
    # silently fall through to testing a transient pre-rename interface name.
    if command -v udevadm &>/dev/null; then
        if ! udevadm settle --timeout=10; then
            echo "Error: udev events did not settle; no CAN interfaces were configured" >&2
            return 1
        fi
    else
        echo "Warning: udevadm is unavailable; waiting for stable CAN interface names" >&2
    fi
    # Require two equal, complete snapshots; retry late module probes/renames.
    for ((attempt=0; attempt<40; attempt++)); do
        if ! current=$(get_available_can_devices); then
            echo "Error: Unable to list network interfaces with ip" >&2
            return 1
        fi
        CAN_DEVICES=()
        if [[ -n "$current" ]]; then
            mapfile -t CAN_DEVICES <<< "$current"
        fi
        if [[ "$current" == "$previous" ]] && requested_devices_present; then
            return 0
        fi
        previous=$current
        sleep 0.25
    done
    echo "Error: Requested CAN interfaces did not become ready after waiting for udev" >&2
    echo "Available CAN interfaces: ${CAN_DEVICES[*]:-(none)}" >&2
    echo "Use actual names from 'ip -o link show'; /dev links are not SocketCAN interfaces." >&2
    return 1
}

if ((RELOAD_DRIVER)); then
    echo "Reloading KCAN driver..."
    sudo rmmod kcan peak_usb pcan 2>/dev/null || true
    sleep 0.5
    if ! sudo modprobe kcan; then
        echo "Error: Unable to load KCAN driver" >&2
        exit 1
    fi
    echo "KCAN driver reloaded"
else
    echo "Keeping current drivers (--no-reload)"
fi

wait_for_can_devices || exit 1
echo "Available CAN interfaces: ${CAN_DEVICES[*]}"
for dev in "${CAN_DEVICES[@]}"; do
    ifconfig "$dev"
done
build_groups

show_configuration

# Configure exactly the validated groups, including udev-renamed interfaces.
declare -A interfaces_to_configure
for group in "${groups[@]}"; do
    interfaces_to_configure[${group%%:*}]=1
    interfaces_to_configure[${group#*:}]=1
done

# Configure all CAN interfaces
for iface in "${!interfaces_to_configure[@]}"; do
    echo "Enabling $iface..."

    sudo ip link set dev "$iface" down 2>/dev/null

    # Set CAN parameters based on mode
    if [[ "$MODE" == "can" ]]; then
        # CAN 2.0 mode
        if ! sudo ip link set dev "$iface" type can bitrate $BITRATE ; then
            echo "Configuration failed"
            exit 1
        fi
    else
        # CAN FD mode
        if ! sudo ip link set dev "$iface" type can bitrate $BITRATE dbitrate $DBITRATE fd on ; then
            echo "Configuration failed"
            exit 1
        fi
    fi

    if ! sudo ip link set dev "$iface" up; then
        echo "Error: Unable to bring up $iface" >&2
        exit 1
    fi
    echo "$iface configured successfully"
done

if [[ "$MODE" == "can" ]]; then
    echo "All interfaces configured with bitrate=$BITRATE (CAN 2.0 mode)"
else
    echo "All interfaces configured with bitrate=$BITRATE, dbitrate=$DBITRATE (CAN FD mode)"
fi

cleanup() {
    pkill -f 'kcanfdtest -[bd]' 2>/dev/null && echo "Terminated all kcanfdtest processes" || true
    exit $exit_code
}
trap cleanup SIGINT

# Create LOG_DIR
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TIMESTAMP="$(date +"%Y%m%d_%H%M%S")"
LOG_DIR=./kcanfd_test_${TIMESTAMP}
mkdir -p "$LOG_DIR"

declare -A device_groups
declare -A sender_pids
declare -A start_times

echo "Configured test groups:"
for group in "${groups[@]}"; do
    receiver="${group%%:*}"
    sender="${group#*:}"
    echo "  $receiver (receiver) <-> $sender (sender)"
done

# Get packet counts from interface stats
get_packets_count() {
    local device="$1"
    local mode="$2"

    local stats
    stats=$(ip -s link show "$device" 2>/dev/null)
    if [ $? -ne 0 ]; then
        echo 0
        return
    fi

    if [ "$mode" = "tx" ]; then
        echo "$stats" | awk '/TX: / {getline; print $2}'
    elif [ "$mode" = "rx" ]; then
        echo "$stats" | awk '/RX: / {getline; print $2}'
    else
        echo 0
    fi
}

# Network counters survive --no-reload; compare deltas for this run.
declare -A initial_tx_packets initial_rx_packets
for iface in "${!interfaces_to_configure[@]}"; do
    initial_tx_packets[$iface]=$(get_packets_count "$iface" tx)
    initial_rx_packets[$iface]=$(get_packets_count "$iface" rx)
done

# Start test groups
for group in "${groups[@]}"; do
    # Split into receiver/sender
    receiver="${group%%:*}"
    sender="${group#*:}"
    
    build_test_commands "$receiver" "$sender"
    show_test_commands

    # Start receiver
    "${receiver_cmd[@]}" > "${LOG_DIR}/can_${receiver}.log" 2>&1 &
    
    # Record start time
    start_time=$(date +%s.%N)
    
    # Start sender
    "${sender_cmd[@]}" > "${LOG_DIR}/can_${sender}.log" 2>&1 &
    sender_pid=$!
    
    device_groups[$sender_pid]="$receiver:$sender"
    start_times[$sender_pid]=$start_time
    
    echo "Started test group: $receiver (receiver) and $sender (sender) [PID:$sender_pid]"
    echo "  Mode: $([[ "$MODE" == "can" ]] && echo "CAN 2.0" || echo "CAN FD")"
    echo "  Sender packets count: $TEST_COUNT"
    sleep 1
done

# Calculate and display total frame rate (TX + RX)
calculate_total_frame_rate() {
    local pid=$1
    local receiver=$2
    local sender=$3
    
    # Get start and end times
    start_time=${start_times[$pid]}
    end_time=$(date +%s.%N)
    
    # Calculate duration (seconds)
    duration=$(echo "$end_time - $start_time" | bc)
    
    # Get actual packet counts
    tx_packets=$(get_packets_count "$sender" "tx")
    rx_packets=$(get_packets_count "$receiver" "rx")
    tx_packets=$((tx_packets - initial_tx_packets[$sender]))
    rx_packets=$((rx_packets - initial_rx_packets[$receiver]))
    
    # Calculate total frame rate
    total_frames=$((tx_packets + rx_packets))
    total_rate=$(echo "scale=2; $total_frames / $duration" | bc)
    
    # Display results
    echo "  Frame rate for $sender <-> $receiver: $total_rate frames/sec"
    echo "    Duration: $duration seconds"
    echo "    Frames: $total_frames"
    
    # Save frame rate to log file
    echo "Frame rate for $sender <-> $receiver: $total_rate frames/sec" >> "${LOG_DIR}/frame_rates.log"
    echo "  Duration: $duration seconds" >> "${LOG_DIR}/frame_rates.log"
    echo "  Frames: $total_frames" >> "${LOG_DIR}/frame_rates.log"
    echo "" >> "${LOG_DIR}/frame_rates.log"
}

# Verify packet counts match with +49 requirement
check_device_packets() {
    local device="$1"
    local tx_packets rx_packets
    local expected_count=$((TEST_COUNT))
    
    tx_packets=$(get_packets_count "$device" "tx")
    rx_packets=$(get_packets_count "$device" "rx")
    tx_packets=$((tx_packets - initial_tx_packets[$device]))
    rx_packets=$((rx_packets - initial_rx_packets[$device]))
    
    if [[ "$tx_packets" -eq "$expected_count" && "$rx_packets" -eq "$expected_count" ]]; then
        echo "  $device: TX=$tx_packets, RX=$rx_packets → Test PASSED"
        return 0
    elif [[ "$tx_packets" -eq 0 || "$rx_packets" -eq 0 ]]; then
        echo "  $device: TX=$tx_packets, RX=$rx_packets → Test FAILED (No packets detected)"
        echo "    - Communication parameter setting problem"
        return 2
    else
        echo "  $device: TX=$tx_packets, RX=$rx_packets, expected $expected_count → Test FAILED"
        return 1
    fi
}

# Monitor test progress
monitor_senders() {
    echo "Monitoring sender status..."
    all_passed=true
    
    # Add reference note to frame rates log
    echo "The following frame rates are calculated by the Script, for reference only:" > "${LOG_DIR}/frame_rates.log"
    echo "" >> "${LOG_DIR}/frame_rates.log"
    
    for pid in "${!device_groups[@]}"; do
        wait $pid 2>/dev/null
        
        pair="${device_groups[$pid]}"
        receiver="${pair%%:*}"
        sender="${pair#*:}"
        SENDER_LOG="${LOG_DIR}/can_${sender}.log"
        
        if grep -q "Exiting" "$SENDER_LOG"; then
            echo "Sender ($sender) finished transmission. Verifying packets..."
            
            # Calculate and display total frame rate
            calculate_total_frame_rate $pid $receiver $sender

            # Check for abnormal receive operations in sender interface
            if grep -q "recvmsg()" "$SENDER_LOG"; then
                echo "  ERROR: Sender $sender → TEST FAILED (Abnormal send operation)"
                echo "  Details in log: $SENDER_LOG"
                all_passed=false
                continue
            fi
            
            echo "Checking $receiver:"
            if ! check_device_packets "$receiver"; then
                all_passed=false
            fi
            
            echo "Checking $sender:"
            if ! check_device_packets "$sender"; then
                all_passed=false
            fi
        else
            echo "WARNING: Sender ($sender) exited abnormally (missing 'Exiting' marker)"
            all_passed=false
        fi
    done
    
    # Final test summary
    if $all_passed; then
        echo "All tests PASSED successfully!"
        exit_code=0
    else
        echo "Some tests FAILED! Check logs for details"
        exit_code=1
    fi
    
    # Save network interface information to log files - FILTERED FOR CAN DEVICES
    echo "Saving filtered network interface information..."
    
    # ifconfig -a filtered for CAN devices
    echo "===== ifconfig -a (CAN devices only) =====" > "${LOG_DIR}/ifconfig_can.log"
    while IFS= read -r dev; do
        [[ -n "$dev" ]] || continue
        ifconfig "$dev" >> "${LOG_DIR}/ifconfig_can.log"
        echo "" >> "${LOG_DIR}/ifconfig_can.log"
    done < <(get_available_can_devices)
    
    # ip -s link show filtered for CAN devices
    echo "===== ip -s link show (CAN devices only) =====" > "${LOG_DIR}/ip_link_can.log"
    while IFS= read -r dev; do
        [[ -n "$dev" ]] || continue
        ip -s link show dev "$dev" >> "${LOG_DIR}/ip_link_can.log"
        echo "" >> "${LOG_DIR}/ip_link_can.log"
    done < <(get_available_can_devices)
    
    echo "All logs saved to: $LOG_DIR"
    cleanup
}

# Handle case with no test groups
if [ ${#groups[@]} -eq 0 ]; then
    echo "No valid test groups created. Ensure at least 2 ports are enabled."
    exit 1
fi

echo "Test started with $TEST_COUNT packets per sender. Auto-monitoring enabled..."
echo "The log file will be stored in $LOG_DIR"
monitor_senders
